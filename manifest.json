{
  "manifest_version": 3,
  "name": "Web Doc to Markdown Exporter",
  "version": "1.3",
  "description": "Exporta documentações web para Markdown em .ZIP com tradução híbrida (Google + Docker)",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://translate.googleapis.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}